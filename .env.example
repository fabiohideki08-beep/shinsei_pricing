# ============================================================
# Shinsei Pricing — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais
# ============================================================

# ---- Bling OAuth ----
BLING_CLIENT_ID=seu_client_id_aqui
BLING_CLIENT_SECRET=seu_client_secret_aqui
BLING_REDIRECT_URI=http://127.0.0.1:8000/bling/callback

# ---- Melhor Envio ----
# Gere em: https://melhorenvio.com.br/painel/gerenciar/tokens
MELHOR_ENVIO_TOKEN=seu_token_aqui

# true = sandbox (testes), false = produção
MELHOR_ENVIO_SANDBOX=true

# ---- Motor de Frete (Shinsei) ----
# Subsídio de frete embutido em cada produto (R$)
FRETE_SUBSIDIO_POR_ITEM=8.0

# CEP de origem dos envios (Osasco/SP)
FRETE_CEP_ORIGEM=06036003
